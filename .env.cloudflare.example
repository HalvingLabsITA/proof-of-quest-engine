# Copia in .env.cloudflare (mai committato) e compila.
# Token: dash.cloudflare.com > Profilo > API Tokens > Create Token > modello "Edit Cloudflare Workers"
#        poi aggiungi il permesso: Account > D1 > Edit (serve per la classifica)
CLOUDFLARE_API_TOKEN=
# Account ID: dash.cloudflare.com > Workers & Pages > colonna a destra "Account ID"
CLOUDFLARE_ACCOUNT_ID=
